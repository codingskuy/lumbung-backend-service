# Contoh variabel lingkungan lumbung-backend-service. SALIN ke .env dan isi nilainya.
# JANGAN commit nilai nyata (.env diabaikan git). Kelima rahasia di bawah wajib diisi.

# 1. String koneksi Postgres basis data logis `lumbung` (DB per service).
DATABASE_URL=

# 2. Kunci penanda JWT ed25519, PEM PKCS#8 (openssl genpkey -algorithm ed25519).
JWT_ED25519_PRIVATE=

# 3. Kunci verifikasi JWT ed25519, PEM SPKI (openssl pkey -in priv.pem -pubout).
JWT_ED25519_PUBLIC=

# 4. Kunci API perangkat gudang (X-Device-Key); rotasi 90 hari, tenggang 7 hari.
DEVICE_API_KEY_GUDANG=

# 5. Kunci layanan server-ke-server (X-Service-Key). Sisi web SvelteKit menyimpan nilai yang sama
#    sebagai LUMBUNG_API_KEY (variabel lingkungan server, tidak pernah dikirim ke browser).
SERVICE_API_KEY=

# Opsional (bukan rahasia):
# LISTEN_ADDR=0.0.0.0:8080
# RUST_LOG=info
